# ---- Data assets (too large for git; shared out-of-band) ----
cleaned/
*.csv
*.rar
.ipynb_checkpoints/

# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# ---- Routing experiment artifacts (regenerated by scripts) ----
# Ignore the bulk, but keep the tiny frozen files the deployed demo server
# reads at runtime, so a `vercel` CLI deploy ships them. routing_matrix.csv
# (11 MB) and other build-only artifacts stay ignored.
routing/data/*
!routing/data/query_meta.csv
!routing/data/splits.csv
!routing/data/splits_manifest.json
routing/results/*
!routing/results/*.csv
routing/models/*
!routing/models/router_weights.npz
!routing/models/mo_objectives.json

# ---- OS / editor ----
Thumbs.db
desktop.ini
.vscode/
.idea/
.qoder/

# ---- Secrets (never commit; run_eval.py reads keys from the environment) ----
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
secrets.json
service-account*.json
*-credentials.json

# ---- Node / React frontend (webapp/frontend) ----
node_modules/
npm-debug.log*
yarn-error.log*
.vite/
# NOTE: webapp/frontend/dist is committed on purpose (611 KB) so the React
# dashboard runs on a fresh clone with no Node toolchain. Rebuild it with:
#   cd webapp/frontend && npm install && npm run build

# ---- Test / tooling caches ----
.pytest_cache/
.coverage
htmlcov/

# ---- Local-only captures ----
/screenshots/
/_shots/
!figures/screenshots/

# Temporary audit artifacts
_tmp_*

# ---- Vercel deploy ----
# vercel.json, .vercelignore and api/ ARE committed (the deploy config). These
# are local-only: the CLI's project-link dir and the temp login/deploy scripts
# + logs generated by the deployment workflow.
.vercel/
.vercel-tmp/

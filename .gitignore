__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# ---- Routing experiment artifacts (regenerated by scripts) ----
routing/data/
routing/results/
routing/models/

# ---- OS / editor ----
Thumbs.db
desktop.ini
.vscode/

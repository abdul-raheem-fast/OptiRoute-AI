{
  "_meta": {
    "description": "Model registry for the multi-LLM evaluation and routing suite. Add a new model by copying the _template entry, filling in its fields, and running run_eval.py --model <key>. Prices are USD per 1M tokens and reflect the snapshot_date listed per model.",
    "schema": {
      "provider": "Human-readable provider name",
      "api_base": "OpenAI-compatible base URL; env var name in {} is resolved at runtime",
      "model_id": "Exact model ID sent to the API",
      "api_key_env": "Environment variable holding the API key",
      "price_per_1m_input": "USD per 1M prompt tokens",
      "price_per_1m_output": "USD per 1M completion tokens",
      "snapshot_date": "Date the pricing/config was captured",
      "notes": "Free-form notes"
    }
  },
